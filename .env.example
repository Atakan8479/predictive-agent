# Copy to .env and adjust. All settings use the PA_ prefix (see src/predictive_agent/config.py).

# LLM provider (any OpenAI-compatible endpoint)
PA_LLM_BASE_URL=http://localhost:11434/v1
PA_LLM_API_KEY=ollama
PA_LLM_MODEL=qwen3.5:9b-q4_K_M
PA_LLM_THINK=false

# Ollama native API (doctor, warm-up)
PA_OLLAMA_URL=http://localhost:11434
PA_OLLAMA_KEEP_ALIVE=30m

# Local infrastructure (Docker Compose host bindings)
PA_INFRA_BIND_ADDRESS=127.0.0.1
PA_VALKEY_PORT=6379
PA_NATS_PORT=4222
PA_NATS_MONITOR_PORT=8222
PA_TOXIPROXY_API_PORT=8474
PA_JAEGER_UI_PORT=16686
PA_JAEGER_OTLP_GRPC_PORT=4317
PA_JAEGER_OTLP_HTTP_PORT=4318
PA_MOCK_APIS_PORT=8080

# Feature flags
PA_PREFETCH_ENABLED=false
